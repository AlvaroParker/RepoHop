{
  "manifest_version": 3,
  "name": "RepoHop",
  "version": "0.1.0",
  "description": "Open selected owner/repo text on GitHub in a new tab.",
  "permissions": ["menus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; connect-src 'none'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "repohop@alvaroparker.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
