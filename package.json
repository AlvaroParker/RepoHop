{
  "name": "repohop",
  "version": "0.1.0",
  "private": true,
  "description": "Open selected owner/repo text on GitHub from Firefox or Zen.",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --project src/tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "build": "node scripts/build.ts",
    "web-ext": "web-ext --no-config-discovery --artifacts-dir artifacts",
    "validate": "npm run web-ext -- lint --source-dir dist --warnings-as-errors",
    "package": "npm run build && npm run validate && npm run web-ext -- build --source-dir dist --filename repohop.zip --overwrite-dest && npm run validate:package",
    "validate:package": "npm run web-ext -- lint --source-dir artifacts/repohop.zip --warnings-as-errors",
    "start": "npm run build && npm run web-ext -- run --source-dir dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "web-ext": "10.7.0"
  }
}
